# ==============================================================================
# Speqtus Medical Ordering Platform — Environment Variables Template
# Governed by: Planning/VARIABLE_REGISTRY.md
# ==============================================================================

# Supabase Gateway & Auth (Client-facing)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Privileged Service Role (Edge Functions & Scripts ONLY — Never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare R2 Storage & CDN (Image bucket)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=speqtus-product-images
R2_PUBLIC_URL_PREFIX=https://images.speqtusmedical.com

# Resend Email API for Transactional Alerts
RESEND_API_KEY=re_123456789
OWNER_EMAIL=owner@speqtus.com

# WhatsApp Business Phone for Offline Order Fallback
EXPO_PUBLIC_WHATSAPP_PHONE=+91XXXXXXXXXX

# Speqtus Customer Direct Support Phone
EXPO_PUBLIC_SUPPORT_PHONE=+91XXXXXXXXXX

# Allowed Web Admin Origin for Edge Function CORS
ALLOWED_ORIGIN=https://admin.speqtusmedical.com

